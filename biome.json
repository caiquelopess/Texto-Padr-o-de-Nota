{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "tests/**", "scripts/**", "*.mjs", "*.json", "!index.html", "!teste", "!package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/ui/**", "src/estilos.css", "src/pagina.html"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "style": "off",
          "complexity": "off",
          "suspicious": {
            "noRedeclare": "off",
            "noGlobalIsNan": "off",
            "noAssignInExpressions": "off",
            "noImplicitAnyLet": "off",
            "noDocumentCookie": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noInnerDeclarations": "off",
            "noSwitchDeclarations": "off",
            "noUnusedFunctionParameters": "off"
          },
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": ["src/pagina.html"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
